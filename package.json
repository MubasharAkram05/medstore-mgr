{
  "name": "medstore-mgr",
  "version": "1.1.0",
  "private": true,
  "description": "MedStoreMgr - offline medical store sales and price tracker (Android app via Capacitor)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o www/css/tailwind.css --minify",
    "vendor": "cp node_modules/lucide/dist/umd/lucide.min.js www/js/vendor/lucide.min.js && cp node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 www/assets/fonts/",
    "sync": "npm run build:css && npx cap sync android",
    "assets": "npx @capacitor/assets generate --android",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@fontsource-variable/inter": "5.3.0",
    "lucide": "1.61.0",
    "tailwindcss": "3.4.19"
  }
}
